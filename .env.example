# Copy to .env to override the defaults used by compose.yaml and bin/*.sh.
# docker compose reads .env automatically; the scripts read it as well.

# Host ports (change them when 8080 / 9200 are already taken)
FESS_HTTP_PORT=8080
SEARCH_HTTP_PORT=9200
# OpenSearch heap; it also hosts the embedding model of the hybrid search
OPENSEARCH_HEAP=2g

# Fess image. `snapshot` is the in-development 15.9 build; pin a 15.9.x tag after
# its release. The Ubuntu-based "-noble" variant ships ImageMagick, poppler and
# LibreOffice, which PDF / Office / image thumbnails need. The Alpine tag
# (ghcr.io/codelibs/fess:snapshot) has none of them and produces no thumbnails.
FESS_IMAGE=ghcr.io/codelibs/fess:snapshot-noble

# Static theme to mount (bin/setup.sh copies themes/<name> from fess-themes).
# Keep it in sync with theme.default in data/fess/opt/fess/system.properties.
THEME_NAME=filesearch
# Local fess-themes checkout to copy the theme from (otherwise a shallow clone
# of FESS_THEMES_REPO at FESS_THEMES_REF is used).
# FESS_THEMES_DIR=/path/to/fess-themes
# FESS_THEMES_REPO=https://github.com/codelibs/fess-themes.git
# FESS_THEMES_REF=main

# Administrator account used by bin/configure.sh (the Fess default)
FESS_ADMIN_USER=admin
FESS_ADMIN_PASSWORD=admin

# Seconds bin/configure.sh waits for Fess, the crawl and the Content Chunk Vector Indexer
# HEALTH_TIMEOUT=300
# CRAWL_TIMEOUT=600
# VECTOR_TIMEOUT=1800

# --- Hybrid search: embedding model (registered and deployed by init-semantic) ---
# Multilingual, so English and Japanese files share one vector space. The first run
# downloads it (about 490 MB) inside OpenSearch.
MODEL_NAME=huggingface/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_VERSION=1.0.1
# Must match the model. Fixed in the index mapping when the index is first created.
# Change MODEL_NAME, MODEL_DIMENSION and CHUNK_SIZE only on a fresh index (see README,
# Stop, update, reset): vectors and chunks already stored are not redone, so a new
# model would be mixed with old vectors without any error.
MODEL_DIMENSION=384
# Seconds init-semantic waits for each ML task (the download and the deploy)
MODEL_MAX_WAIT=900

# --- Hybrid search: chunking and the vector half (measured on the sample tree; see README) ---
# Characters per chunk. The model reads about the first 128 tokens of a chunk.
CHUNK_SIZE=500
# Minimum cosine similarity (0-1) for a file to be returned by the vector half.
# Scores are specific to the model and the chunk size: re-measure after changing either.
SEMANTIC_MIN_SCORE=0.35

# Switches (see README, Hybrid search). Uncomment one to change it.
# Fess fuses the keyword and vector results itself instead of OpenSearch:
# RANK_FUSION_ENGINE=false
# Keyword search only (changing it back to true needs a Fess restart):
# SEMANTIC_SEARCH=false
